# Server Configuration
PORT=5002

# MongoDB Configuration
# Development/default (used when NODE_ENV is not production)
# For local: mongodb://localhost:27017/ijack-notebooks
# For Atlas: mongodb+srv://user:pass@cluster.mongodb.net/dbname?appName=...
MONGODB_URI=mongodb://localhost:27017/ijack-notebooks
# Production cluster (used when NODE_ENV=production). Set before deploying.
MONGODB_URI_PRODUCTION=mongodb+srv://user:pass@prod-cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# ZWITCH Payment Gateway (Layer) - https://developers.zwitch.io/reference
ZWITCH_PG_ACCESS_KEY=your-pg-access-key
ZWITCH_PG_SECRET_KEY=your-pg-secret-key
ZWITCH_ENVIRONMENT=sandbox
# Use production for live payments
ZWITCH_WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret
# Get PG API Keys and Webhook Signing Secret from ZWITCH Dashboard → Developers → PG API Keys / Webhooks

# Frontend and Backend URLs
FRONTEND_URL=https://ijack-web.onrender.com
BACKEND_URL=https://ijack-server.onrender.com

# Supabase Configuration (for PostgreSQL financial data storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Get these from: Supabase Dashboard > Settings > API

# Resend (GST invoice email) - https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender email (must be a verified sender in Resend Dashboard)
# For quick testing, you can use: "I Jack Paper Products <onboarding@resend.dev>"
INVOICE_FROM_EMAIL="I Jack Paper Products <onboarding@resend.dev>"

# Shiprocket shipping
SHIPROCKET_EMAIL=your-api-user-email@example.com
SHIPROCKET_PASSWORD=your-api-user-password
SHIPROCKET_PICKUP_LOCATION=your-saved-pickup-location-name
SHIPROCKET_WEBHOOK_SECRET=your-random-webhook-secret
# Set to false to accept webhooks without token (e.g. for Shiprocket dashboard test). Re-enable for production.
SHIPROCKET_WEBHOOK_AUTH_ENABLED=true
SHIPROCKET_TEST_MODE=false
