# Server Configuration
PORT=5002

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/ijack-notebooks
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ijack-notebooks
MONGODB_URI=mongodb://localhost:27017/ijack-notebooks

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# PhonePe Payment Gateway Configuration
PHONEPE_MERCHANT_ID=your-merchant-id
PHONEPE_SALT_KEY=your-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_CLIENT_ID=your-client-id
PHONEPE_CLIENT_SECRET=your-client-secret
PHONEPE_CLIENT_VERSION=1.0
PHONEPE_ENVIRONMENT=SANDBOX
# Use PRODUCTION for live payments

# Frontend and Backend URLs
FRONTEND_URL=https://ijack-web.onrender.com
BACKEND_URL=https://ijack-server.onrender.com
