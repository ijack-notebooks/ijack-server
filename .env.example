# Server Configuration
PORT=5002

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/ijack-notebooks
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ijack-notebooks
MONGODB_URI=mongodb://localhost:27017/ijack-notebooks

# JWT Secret
JWT_SECRET=your-secret-key-change-in-production

# ZWITCH Payment Gateway (Layer) - https://developers.zwitch.io/reference
ZWITCH_PG_ACCESS_KEY=your-pg-access-key
ZWITCH_PG_SECRET_KEY=your-pg-secret-key
ZWITCH_ENVIRONMENT=sandbox
# Use production for live payments
ZWITCH_WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret
# Get PG API Keys and Webhook Signing Secret from ZWITCH Dashboard → Developers → PG API Keys / Webhooks

# Frontend and Backend URLs
FRONTEND_URL=https://ijack-web.onrender.com
BACKEND_URL=https://ijack-server.onrender.com

# Supabase Configuration (for PostgreSQL financial data storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Get these from: Supabase Dashboard > Settings > API

# Resend (GST invoice email) - https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender email (must be a verified domain in Resend Dashboard)
INVOICE_FROM_EMAIL="I Jack Paper Products <notebookijack@gmail.com>"
